datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique(map: "roles_name_key") @db.VarChar(30)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  users       User[]

  @@map("roles")
}

model User {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authUserId        String?            @unique(map: "users_auth_user_id_key") @map("auth_user_id") @db.Uuid
  roleId            String             @map("role_id") @db.Uuid
  email             String             @unique(map: "users_email_key") @db.VarChar(255)
  displayName       String             @map("display_name") @db.VarChar(100)
  status            String             @default("active") @db.VarChar(30)
  lastLoginAt       DateTime?          @map("last_login_at") @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?          @map("deleted_at") @db.Timestamptz(3)
  role              Role               @relation(fields: [roleId], references: [id], onDelete: Restrict)
  studentProfile    StudentProfile?
  teacherProfile    TeacherProfile?
  createdQuestions  Question[]         @relation("QuestionCreator")
  dailyQaAnswers    DailyQaAnswer[]
  createdMockExams  MockExam[]         @relation("MockExamCreator")
  mockAttempts      MockAttempt[]
  userTitles        UserTitle[]
  titleUnlocks      UserTitleUnlock[]
  randomAttempts    RandomQuizAttempt[]
  activityDays      StudentActivityDay[]
  navigationProgress StudentNavigationProgress[]
  monthlyRankings   MonthlyRanking[]
  practiceSessions  PracticeSession[]
  reviewNotebookItems ReviewNotebookItem[]
  pointTransactions PointTransaction[]
  aiUsageLogs       AiUsageLog[]
  boardPosts        BoardPost[]        @relation("BoardPostAuthor")
  boardComments     BoardComment[]     @relation("BoardCommentAuthor")
  boardPostLikes    BoardPostLike[]    @relation("BoardPostLikeUser")
  boardDeleteLogs   BoardDeleteLog[]   @relation("BoardDeletionActor")
  receivedNotifications Notification[] @relation("NotificationRecipient")
  actedNotifications    Notification[] @relation("NotificationActor")

  @@index([roleId], map: "idx_users_role_id")
  @@index([status], map: "idx_users_status")
  @@map("users")
}

model StudentProfile {
  userId             String   @id @map("user_id") @db.Uuid
  studentNo          String?  @unique(map: "student_profiles_student_no_key") @map("student_no") @db.VarChar(50)
  avatarUrl          String?  @map("avatar_url")
  bio                String?
  currentTitleId     String?  @map("current_title_id") @db.Uuid
  totalPoints        Int      @default(0) @map("total_points")
  totalPracticeCount Int      @default(0) @map("total_practice_count")
  totalCorrectCount  Int      @default(0) @map("total_correct_count")
  totalAnswerCount   Int      @default(0) @map("total_answer_count")
  titleBackfilledAt  DateTime? @map("title_backfilled_at") @db.Timestamptz(3)
  titleTrackingStartedAt DateTime? @map("title_tracking_started_at") @db.Timestamptz(3)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentTitle       Title?   @relation("EquippedTitle", fields: [currentTitleId], references: [id], onDelete: SetNull)

  @@map("student_profiles")
}

model TeacherProfile {
  userId     String   @id @map("user_id") @db.Uuid
  teacherNo  String?  @unique(map: "teacher_profiles_teacher_no_key") @map("teacher_no") @db.VarChar(50)
  department String?  @db.VarChar(100)
  avatarUrl  String?  @map("avatar_url")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("teacher_profiles")
}

model Exam {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String            @unique(map: "exams_code_key") @db.VarChar(50)
  name             String            @db.VarChar(100)
  description      String?
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  questions        Question[]
  mockExams        MockExam[]
  practiceSessions PracticeSession[]

  @@map("exams")
}

model QuestionCategory {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String     @unique(map: "question_categories_code_key") @db.VarChar(50)
  name      String     @db.VarChar(100)
  sortOrder Int        @map("sort_order")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  questions Question[]

  @@map("question_categories")
}

model Question {
  id                       String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceKey                String                    @unique(map: "questions_source_key_key") @map("source_key") @db.VarChar(120)
  examId                   String                    @map("exam_id") @db.Uuid
  categoryId               String                    @map("category_id") @db.Uuid
  sourceYear               Int?                      @map("source_year")
  sourceSeason             String?                   @map("source_season") @db.VarChar(30)
  questionNo               Int?                      @map("question_no")
  questionText             String                    @map("question_text")
  imagePath                String?                   @map("image_path")
  explanation              String?
  questionType             String                    @default("single_choice") @map("question_type") @db.VarChar(30)
  difficulty               Int?
  status                   String                    @default("published") @db.VarChar(30)
  createdBy                String?                   @map("created_by") @db.Uuid
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                DateTime?                 @map("deleted_at") @db.Timestamptz(3)
  exam                     Exam                      @relation(fields: [examId], references: [id], onDelete: Restrict)
  category                 QuestionCategory          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  creator                  User?                     @relation("QuestionCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  choices                  QuestionChoice[]
  dailyQaAnswers           DailyQaAnswer[]
  mockExamQuestions        MockExamQuestion[]
  practiceSessionQuestions PracticeSessionQuestion[]
  practiceAnswers          PracticeAnswer[]
  randomAttempts           RandomQuizAttempt[]
  aiExplanations           AiExplanation[]
  reviewNotebookItems      ReviewNotebookItem[]
  aiUsageLogs              AiUsageLog[]

  @@index([examId], map: "idx_questions_exam_id")
  @@index([categoryId], map: "idx_questions_category_id")
  @@index([createdBy], map: "idx_questions_created_by")
  @@index([status], map: "idx_questions_status")
  @@index([sourceYear, sourceSeason, questionNo], map: "idx_questions_source")
  @@map("questions")
}

model QuestionChoice {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId      String           @map("question_id") @db.Uuid
  choiceLabel     String           @map("choice_label") @db.VarChar(10)
  choiceText      String           @map("choice_text")
  isCorrect       Boolean          @default(false) @map("is_correct")
  sortOrder       Int              @map("sort_order")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  question        Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  dailyQaAnswers  DailyQaAnswer[]
  practiceAnswers PracticeAnswer[]
  randomAttempts  RandomQuizAttempt[]
  reviewNotebookAnswers ReviewNotebookAnswer[]

  @@unique([questionId, choiceLabel], map: "question_choices_question_id_choice_label_key")
  @@unique([questionId, sortOrder], map: "question_choices_question_id_sort_order_key")
  @@index([questionId], map: "idx_question_choices_question_id")
  @@map("question_choices")
}

model DailyQaAnswer {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String         @map("user_id") @db.Uuid
  questionId          String         @map("question_id") @db.Uuid
  selectedChoiceId    String         @map("selected_choice_id") @db.Uuid
  isCorrect           Boolean        @map("is_correct")
  answerDate          DateTime       @map("answer_date") @db.Date
  answeredAt          DateTime       @default(now()) @map("answered_at") @db.Timestamptz(3)
  answerPointAwarded  Boolean        @default(false) @map("answer_point_awarded")
  correctPointAwarded Boolean        @default(false) @map("correct_point_awarded")
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  question            Question       @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selectedChoice      QuestionChoice @relation(fields: [selectedChoiceId], references: [id], onDelete: Restrict)

  @@unique([userId, answerDate], map: "daily_qa_answers_user_id_answer_date_key")
  @@index([questionId], map: "idx_daily_qa_answers_question_id")
  @@index([selectedChoiceId], map: "idx_daily_qa_answers_selected_choice_id")
  @@index([answerDate], map: "idx_daily_qa_answers_answer_date")
  @@map("daily_qa_answers")
}

model PracticeSession {
  id               String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String                    @map("user_id") @db.Uuid
  examId           String                    @map("exam_id") @db.Uuid
  status           String                    @default("in_progress") @db.VarChar(30)
  questionCount    Int                       @default(0) @map("question_count")
  answeredCount    Int                       @default(0) @map("answered_count")
  correctCount     Int                       @default(0) @map("correct_count")
  earnedPoints     Int                       @default(0) @map("earned_points")
  startedAt        DateTime                  @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt      DateTime?                 @map("completed_at") @db.Timestamptz(3)
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam             Exam                      @relation(fields: [examId], references: [id], onDelete: Restrict)
  sessionQuestions PracticeSessionQuestion[]
  answers          PracticeAnswer[]

  @@index([userId], map: "idx_practice_sessions_user_id")
  @@index([examId], map: "idx_practice_sessions_exam_id")
  @@index([startedAt], map: "idx_practice_sessions_started_at")
  @@index([status], map: "idx_practice_sessions_status")
  @@map("practice_sessions")
}

model PracticeSessionQuestion {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId  String          @map("session_id") @db.Uuid
  questionId String          @map("question_id") @db.Uuid
  orderNo    Int             @map("order_no")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  session    PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question   Question        @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([sessionId, questionId], map: "practice_session_questions_session_id_question_id_key")
  @@unique([sessionId, orderNo], map: "practice_session_questions_session_id_order_no_key")
  @@index([questionId], map: "idx_practice_session_questions_question_id")
  @@map("practice_session_questions")
}

model PracticeAnswer {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId        String          @map("session_id") @db.Uuid
  questionId       String          @map("question_id") @db.Uuid
  selectedChoiceId String          @map("selected_choice_id") @db.Uuid
  isCorrect        Boolean         @map("is_correct")
  orderNo          Int             @map("order_no")
  answeredAt       DateTime        @default(now()) @map("answered_at") @db.Timestamptz(3)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  session          PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question         Question        @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selectedChoice   QuestionChoice  @relation(fields: [selectedChoiceId], references: [id], onDelete: Restrict)

  @@unique([sessionId, questionId], map: "practice_answers_session_id_question_id_key")
  @@unique([sessionId, orderNo], map: "practice_answers_session_id_order_no_key")
  @@index([questionId], map: "idx_practice_answers_question_id")
  @@index([selectedChoiceId], map: "idx_practice_answers_selected_choice_id")
  @@map("practice_answers")
}

model PointTransaction {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  points          Int
  reason          String   @db.VarChar(50)
  sourceType      String?  @map("source_type") @db.VarChar(50)
  sourceId        String?  @map("source_id") @db.Uuid
  transactionDate DateTime @map("transaction_date") @db.Date
  description     String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reason, sourceType, sourceId], map: "point_transactions_idempotency_key")
  @@index([userId, transactionDate], map: "idx_point_transactions_user_date")
  @@index([reason, transactionDate], map: "idx_point_transactions_reason_date")
  @@map("point_transactions")
}

model MockExam {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examId           String             @map("exam_id") @db.Uuid
  title            String             @db.VarChar(200)
  targetMonth      DateTime           @map("target_month") @db.Date
  description      String?
  timeLimitMinutes Int                @map("time_limit_minutes")
  questionCount    Int                @default(0) @map("question_count")
  status           String             @default("draft") @db.VarChar(30)
  availableFrom    DateTime           @map("available_from") @db.Timestamptz(3)
  availableUntil   DateTime           @map("available_until") @db.Timestamptz(3)
  rankingFinalizedAt DateTime?        @map("ranking_finalized_at") @db.Timestamptz(3)
  rewardsCompletedAt DateTime?        @map("rewards_completed_at") @db.Timestamptz(3)
  createdBy        String?            @map("created_by") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  exam             Exam               @relation(fields: [examId], references: [id], onDelete: Restrict)
  creator          User?              @relation("MockExamCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  questions        MockExamQuestion[]
  attempts         MockAttempt[]
  rankings         MonthlyRanking[]

  @@unique([examId, targetMonth], map: "mock_exams_exam_id_target_month_key")
  @@unique([id, targetMonth], map: "mock_exams_id_month_key")
  @@index([createdBy], map: "idx_mock_exams_created_by")
  @@index([status], map: "idx_mock_exams_status")
  @@index([availableFrom], map: "idx_mock_exams_available_from")
  @@map("mock_exams")
}

model MockExamQuestion {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mockExamId String   @map("mock_exam_id") @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  orderNo    Int      @map("order_no")
  score      Int      @default(1)
  questionText String @map("question_text")
  imagePath String? @map("image_path")
  explanation String?
  categoryCode String @map("category_code") @db.VarChar(50)
  sourceKey String @map("source_key") @db.VarChar(120)
  sourceYear Int @map("source_year")
  sourceSeason String? @map("source_season") @db.VarChar(30)
  questionNo Int? @map("question_no")
  sourceLabel String @map("source_label") @db.VarChar(200)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  mockExam   MockExam @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  choices MockExamChoice[]
  answers MockAnswer[]

  @@unique([id, mockExamId], map: "mock_exam_questions_id_exam_key")
  @@unique([mockExamId, questionId], map: "mock_exam_questions_mock_exam_id_question_id_key")
  @@unique([mockExamId, orderNo], map: "mock_exam_questions_mock_exam_id_order_no_key")
  @@index([questionId], map: "idx_mock_exam_questions_question_id")
  @@map("mock_exam_questions")
}

model MockExamChoice {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mockExamId String @map("mock_exam_id") @db.Uuid
  mockQuestionId String @map("mock_question_id") @db.Uuid
  originalChoiceId String? @map("original_choice_id") @db.Uuid
  choiceLabel String @map("choice_label") @db.VarChar(10)
  choiceText String @map("choice_text")
  isCorrect Boolean @map("is_correct")
  sortOrder Int @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  question MockExamQuestion @relation(fields: [mockQuestionId, mockExamId], references: [id, mockExamId], onDelete: Restrict)
  answers MockAnswer[]

  @@unique([id, mockQuestionId, mockExamId], map: "mock_exam_choices_id_question_exam_key")
  @@unique([mockQuestionId, choiceLabel], map: "mock_exam_choices_question_label_key")
  @@unique([mockQuestionId, sortOrder], map: "mock_exam_choices_question_order_key")
  @@index([mockQuestionId, mockExamId], map: "idx_mock_exam_choices_question_exam")
  @@index([mockExamId], map: "idx_mock_exam_choices_exam")
  @@map("mock_exam_choices")
}

model MockAttempt {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mockExamId     String       @map("mock_exam_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  startRequestId String       @map("start_request_id") @db.Uuid
  attemptNo      Int          @map("attempt_no")
  status         String       @default("in_progress") @db.VarChar(30)
  startedAt      DateTime     @default(now()) @map("started_at") @db.Timestamptz(3)
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(3)
  submittedAt    DateTime?    @map("submitted_at") @db.Timestamptz(3)
  gradedAt       DateTime?    @map("graded_at") @db.Timestamptz(3)
  totalQuestions Int          @default(0) @map("total_questions")
  correctCount   Int          @default(0) @map("correct_count")
  answeredCount  Int          @default(0) @map("answered_count")
  score          Decimal      @default(0) @db.Decimal(5, 2)
  revision       Int          @default(0)
  earnedPoints   Int          @default(0) @map("earned_points")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  mockExam       MockExam     @relation(fields: [mockExamId], references: [id], onDelete: Restrict)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  answers        MockAnswer[]
  rankings       MonthlyRanking[]
  startRequests  MockAttemptStartRequest[]

  @@unique([mockExamId, userId, attemptNo], map: "mock_attempts_exam_user_number_key")
  @@unique([userId, startRequestId], map: "mock_attempts_user_start_request_key")
  @@unique([id, mockExamId], map: "mock_attempts_id_exam_key")
  @@unique([id, mockExamId, userId], map: "mock_attempts_id_exam_user_key")
  @@index([userId], map: "idx_mock_attempts_user_id")
  @@index([status], map: "idx_mock_attempts_status")
  @@index([startedAt], map: "idx_mock_attempts_started_at")
  @@index([status, expiresAt, id], map: "idx_mock_attempts_due")
  @@index([mockExamId, status, userId], map: "idx_mock_attempts_exam_status_user")
  @@map("mock_attempts")
}

model MockAttemptStartRequest {
  userId String @map("user_id") @db.Uuid
  requestId String @map("request_id") @db.Uuid
  mockExamId String @map("mock_exam_id") @db.Uuid
  attemptId String @map("attempt_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  attempt MockAttempt @relation(fields: [attemptId, mockExamId, userId], references: [id, mockExamId, userId], onDelete: Restrict, map: "mock_attempt_start_requests_attempt_fkey")

  @@id([userId, requestId], map: "mock_attempt_start_requests_pkey")
  @@index([attemptId, mockExamId, userId], map: "idx_mock_attempt_start_requests_attempt")
  @@map("mock_attempt_start_requests")
}

model MockAnswer {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId        String         @map("attempt_id") @db.Uuid
  mockExamId       String         @map("mock_exam_id") @db.Uuid
  mockQuestionId   String         @map("mock_question_id") @db.Uuid
  selectedChoiceId String?        @map("selected_choice_id") @db.Uuid
  isCorrect        Boolean?       @map("is_correct")
  revision         Int            @default(0)
  lastRequestId    String?        @map("last_request_id") @db.Uuid
  scoreAwarded     Int            @default(0) @map("score_awarded")
  answeredAt       DateTime?      @map("answered_at") @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  attempt          MockAttempt    @relation(fields: [attemptId, mockExamId], references: [id, mockExamId], onDelete: Cascade)
  question         MockExamQuestion @relation(fields: [mockQuestionId, mockExamId], references: [id, mockExamId], onDelete: Restrict)
  selectedChoice   MockExamChoice? @relation(fields: [selectedChoiceId, mockQuestionId, mockExamId], references: [id, mockQuestionId, mockExamId], onDelete: Restrict)

  @@unique([attemptId, mockQuestionId], map: "mock_answers_attempt_question_key")
  @@index([mockQuestionId, mockExamId], map: "idx_mock_answers_question_exam")
  @@index([selectedChoiceId, mockQuestionId, mockExamId], map: "idx_mock_answers_choice_question_exam")
  @@map("mock_answers")
}

model Title {
  id                      String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                    String           @unique(map: "titles_name_key") @db.VarChar(100)
  description             String?
  pricePoints             Int              @map("price_points")
  catalogKey              String?          @unique(map: "titles_catalog_key_key") @map("catalog_key") @db.VarChar(30)
  acquisitionKind         String?          @map("acquisition_kind") @db.VarChar(30)
  rarity                  String           @default("normal") @db.VarChar(30)
  isActive                Boolean          @default(true) @map("is_active")
  sortOrder               Int              @default(0) @map("sort_order")
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  equippedStudentProfiles StudentProfile[] @relation("EquippedTitle")
  userTitles              UserTitle[]
  unlocks                 UserTitleUnlock[]
  notifications           Notification[]

  @@index([isActive, sortOrder], map: "idx_titles_active_sort_order")
  @@map("titles")
}

model UserTitle {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  titleId     String    @map("title_id") @db.Uuid
  purchasedAt DateTime  @default(now()) @map("purchased_at") @db.Timestamptz(3)
  equippedAt  DateTime? @map("equipped_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       Title     @relation(fields: [titleId], references: [id], onDelete: Restrict)

  @@unique([userId, titleId], map: "user_titles_user_id_title_id_key")
  @@index([titleId], map: "idx_user_titles_title_id")
  @@map("user_titles")
}

model UserTitleUnlock {
  userId     String   @map("user_id") @db.Uuid
  titleId    String   @map("title_id") @db.Uuid
  unlockedAt DateTime @default(now()) @map("unlocked_at") @db.Timestamptz(3)
  source     String   @db.VarChar(30)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      Title    @relation(fields: [titleId], references: [id], onDelete: Restrict)

  @@id([userId, titleId])
  @@index([titleId], map: "idx_user_title_unlocks_title_id")
  @@map("user_title_unlocks")
}

model RandomQuizAttempt {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String          @map("user_id") @db.Uuid
  questionId       String          @map("question_id") @db.Uuid
  issuedAt         DateTime        @default(now()) @map("issued_at") @db.Timestamptz(3)
  selectedChoiceId String?         @map("selected_choice_id") @db.Uuid
  isCorrect        Boolean?        @map("is_correct")
  answerDate       DateTime?       @map("answer_date") @db.Date
  answeredAt       DateTime?       @map("answered_at") @db.Timestamptz(3)
  answerSequence   Int?            @map("answer_sequence")
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  question         Question        @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selectedChoice   QuestionChoice? @relation(fields: [selectedChoiceId], references: [id], onDelete: Restrict)

  @@unique([userId, answerSequence], map: "random_quiz_attempts_user_sequence_key")
  @@index([userId, answerDate, answerSequence], map: "idx_random_quiz_attempts_user_date_sequence")
  @@index([questionId], map: "idx_random_quiz_attempts_question_id")
  @@index([selectedChoiceId], map: "idx_random_quiz_attempts_selected_choice_id")
  @@map("random_quiz_attempts")
}

model StudentActivityDay {
  userId       String   @map("user_id") @db.Uuid
  activityDate DateTime @map("activity_date") @db.Date
  hasAnswered  Boolean  @default(false) @map("has_answered")
  firstSeenAt  DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt   DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, activityDate])
  @@map("student_activity_days")
}

model StudentNavigationProgress {
  userId       String @map("user_id") @db.Uuid
  tabId        String @map("tab_id") @db.VarChar(100)
  lastSequence Int    @default(0) @map("last_sequence")
  stage        String @default("idle") @db.VarChar(30)
  roundTrips   Int    @default(0) @map("round_trips")
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, tabId])
  @@map("student_navigation_progress")
}

model MonthlyRanking {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetMonth   DateTime @map("target_month") @db.Date
  userId        String   @map("user_id") @db.Uuid
  mockExamId    String   @map("mock_exam_id") @db.Uuid
  bestAttemptId String   @map("best_attempt_id") @db.Uuid
  rankNo        Int      @map("rank_no")
  monthlyPoints Int      @default(0) @map("monthly_points")
  mockScore     Decimal  @map("mock_score") @db.Decimal(5, 2)
  correctCount  Int      @map("correct_count")
  totalQuestions Int    @map("total_questions")
  isFinal       Boolean @default(false) @map("is_final")
  rewardProcessedAt DateTime? @map("reward_processed_at") @db.Timestamptz(3)
  rewardPoints  Int      @default(0) @map("reward_points")
  calculatedAt  DateTime @default(now()) @map("calculated_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  mockExam      MockExam @relation(fields: [mockExamId, targetMonth], references: [id, targetMonth], onDelete: Restrict)
  bestAttempt   MockAttempt @relation(fields: [bestAttemptId, mockExamId, userId], references: [id, mockExamId, userId], onDelete: Restrict)

  @@unique([mockExamId, userId], map: "monthly_rankings_exam_user_key")
  @@index([mockExamId, rankNo], map: "idx_monthly_rankings_exam_rank")
  @@index([bestAttemptId, mockExamId, userId], map: "idx_monthly_rankings_best_attempt")
  @@index([userId, targetMonth], map: "idx_monthly_rankings_user_month")
  @@index([userId], map: "idx_monthly_rankings_user_id")
  @@map("monthly_rankings")
}

model MockExamJobRun {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobKey String @unique(map: "mock_exam_job_runs_job_key_key") @map("job_key") @db.VarChar(200)
  kind String @db.VarChar(30)
  targetMonth DateTime @map("target_month") @db.Date
  examCode String? @map("exam_code") @db.VarChar(50)
  status String @default("pending") @db.VarChar(30)
  attempts Int @default(0)
  leaseToken String? @map("lease_token") @db.Uuid
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(3)
  nextRunAt DateTime @default(now()) @map("next_run_at") @db.Timestamptz(3)
  cursor String?
  lastErrorCode String? @map("last_error_code") @db.VarChar(80)
  lastErrorAt DateTime? @map("last_error_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, nextRunAt], map: "idx_mock_exam_job_runs_due")
  @@index([leaseUntil], map: "idx_mock_exam_job_runs_lease")
  @@map("mock_exam_job_runs")
}

model AiExplanation {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  modelName  String   @map("model_name") @db.VarChar(80)
  answerText String   @map("answer_text")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, modelName], map: "ai_explanations_question_id_model_name_key")
  @@index([questionId], map: "idx_ai_explanations_question_id")
  @@map("ai_explanations")
}

model AiUsageLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  usedAt     DateTime @default(now()) @map("used_at") @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt], map: "idx_ai_usage_logs_user_used_at")
  @@index([questionId], map: "idx_ai_usage_logs_question_id")
  @@map("ai_usage_logs")
}

model BoardPost {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId  String          @map("author_id") @db.Uuid
  body      String
  isPinned  Boolean         @default(false) @map("is_pinned")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime?       @map("deleted_at") @db.Timestamptz(3)
  author    User            @relation("BoardPostAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  comments  BoardComment[]
  likes     BoardPostLike[]
  notifications Notification[]

  @@index([authorId], map: "idx_board_posts_author_id_fk")
  @@map("board_posts")
}

model BoardComment {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String    @map("post_id") @db.Uuid
  authorId  String    @map("author_id") @db.Uuid
  body      String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  post      BoardPost @relation(fields: [postId], references: [id], onDelete: Restrict)
  author    User      @relation("BoardCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  notifications Notification[]

  @@index([postId], map: "idx_board_comments_post_id_fk")
  @@index([authorId], map: "idx_board_comments_author_id_fk")
  @@map("board_comments")
}

model BoardPostLike {
  postId    String    @map("post_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  post      BoardPost @relation(fields: [postId], references: [id], onDelete: Restrict)
  user      User      @relation("BoardPostLikeUser", fields: [userId], references: [id], onDelete: Restrict)

  @@id([postId, userId])
  @@index([userId], map: "idx_board_post_likes_user_id")
  @@map("board_post_likes")
}

model BoardDeleteLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetType  String   @map("target_type") @db.VarChar(20)
  targetId    String   @map("target_id") @db.Uuid
  deletedById String   @map("deleted_by") @db.Uuid
  reason      String?
  deletedAt   DateTime @default(now()) @map("deleted_at") @db.Timestamptz(3)
  deletedBy   User     @relation("BoardDeletionActor", fields: [deletedById], references: [id], onDelete: Restrict)

  @@index([deletedById, deletedAt(sort: Desc)], map: "idx_board_delete_logs_actor_time")
  @@index([targetType, targetId], map: "idx_board_delete_logs_target")
  @@map("board_delete_logs")
}

model Notification {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId    String        @map("recipient_id") @db.Uuid
  actorId        String?       @map("actor_id") @db.Uuid
  type           String        @db.VarChar(30)
  boardPostId    String?       @map("board_post_id") @db.Uuid
  boardCommentId String?       @map("board_comment_id") @db.Uuid
  titleId        String?       @map("title_id") @db.Uuid
  targetMonth    DateTime?     @map("target_month") @db.Date
  readAt         DateTime?     @map("read_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  recipient      User          @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  actor          User?         @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Restrict)
  boardPost      BoardPost?    @relation(fields: [boardPostId], references: [id], onDelete: Restrict)
  boardComment   BoardComment? @relation(fields: [boardCommentId], references: [id], onDelete: Restrict)
  title          Title?        @relation(fields: [titleId], references: [id], onDelete: Restrict)

  @@unique([recipientId, type, boardCommentId], map: "notifications_recipient_type_comment_key")
  @@unique([recipientId, type, boardPostId], map: "notifications_recipient_type_post_key")
  @@unique([recipientId, type, titleId], map: "notifications_recipient_type_title_key")
  @@unique([recipientId, type, targetMonth], map: "notifications_recipient_type_month_key")
  @@index([recipientId], map: "idx_notifications_recipient_id")
  @@index([actorId], map: "idx_notifications_actor_id")
  @@index([boardPostId], map: "idx_notifications_board_post_id")
  @@index([boardCommentId], map: "idx_notifications_board_comment_id")
  @@index([titleId], map: "idx_notifications_title_id")
  @@index([recipientId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_notifications_recipient_created")
  @@map("notifications")
}

model ReviewNotebookItem {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  questionId     String   @map("question_id") @db.Uuid
  status         String   @default("unreviewed") @db.VarChar(30)
  firstWrongAt   DateTime @map("first_wrong_at") @db.Timestamptz(3)
  lastWrongAt    DateTime @map("last_wrong_at") @db.Timestamptz(3)
  lastReviewedAt DateTime? @map("last_reviewed_at") @db.Timestamptz(3)
  revision       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question       Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  answers        ReviewNotebookAnswer[]

  @@unique([userId, questionId], map: "review_items_user_question_key")
  @@unique([id, userId], map: "review_items_id_user_key")
  @@index([userId, status, lastWrongAt(sort: Desc), id], map: "idx_review_items_user_status_wrong")
  @@index([userId, lastWrongAt(sort: Desc), id], map: "idx_review_items_user_wrong")
  @@index([questionId], map: "idx_review_items_question")
  @@map("review_notebook_items")
}

model ReviewNotebookAnswer {
  userId           String   @map("user_id") @db.Uuid
  requestId        String   @map("request_id") @db.Uuid
  itemId           String   @map("item_id") @db.Uuid
  expectedRevision Int      @map("expected_revision")
  questionVersion  String   @map("question_version") @db.VarChar(64)
  selectedChoiceId String   @map("selected_choice_id") @db.Uuid
  isCorrect        Boolean  @map("is_correct")
  answeredAt       DateTime @map("answered_at") @db.Timestamptz(3)
  result           Json     @db.JsonB
  item             ReviewNotebookItem @relation(fields: [itemId, userId], references: [id, userId], onDelete: Cascade)
  selectedChoice   QuestionChoice @relation(fields: [selectedChoiceId], references: [id], onDelete: Restrict)

  @@id([userId, requestId])
  @@unique([itemId, expectedRevision], map: "review_answers_item_revision_key")
  @@index([itemId, userId], map: "idx_review_answers_item_user")
  @@index([selectedChoiceId], map: "idx_review_answers_choice")
  @@map("review_notebook_answers")
}
